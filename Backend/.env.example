# Database configuration
DB_TYPE=mysql
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# JWT
SECRET_WORD=

# Mailer (recuperación de contraseña)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
# Nombre del remitente que ve el usuario en el mail de recuperación. Sin
# definir, usa "Soporte".
MAIL_FROM_NAME=

# URL del frontend para armar el link del mail de recuperación de clave
FRONTEND_URL=http://localhost:5173

# Lista de orígenes permitidos por CORS, separados por coma (ej: "https://mi-frontend.com,https://admin.mi-frontend.com").
# Sin definir, se permite solo FRONTEND_URL (ya no cae a "*").
CORS_ORIGIN=

PORT=3006

# /auth/nuevo-usuario requiere ser ADMIN, así que una base de datos nueva no
# tiene forma de crear el primer usuario. Si no existe ningún ADMIN todavía
# y SEED_ADMIN_NICK/SEED_ADMIN_PASSWORD están seteadas, se crea ese usuario
# automáticamente al arrancar (ver AppService.seedInitialAdmin) — el email
# es opcional. Sacar estas líneas del .env después del primer arranque de
# un proyecto nuevo.
SEED_ADMIN_NICK=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Mercado Pago — Checkout Pro (ver Backend/CLAUDE.md, sección "Carrito de
# compra + Mercado Pago"). Access Token de una cuenta de PRUEBA (sandbox)
# mientras se desarrolla — se consigue en
# https://www.mercadopago.com.ar/developers/panel/app, sección
# "Credenciales de prueba". Sin esta variable, el resto de la app funciona
# igual: solo falla al intentar crear un pedido (POST /ordenes), con un
# mensaje claro.
MERCADOPAGO_ACCESS_TOKEN=
# true (default) mientras se usa una cuenta/token de prueba — hace que
# POST /ordenes devuelva la URL de sandbox (sandbox_init_point) en vez de
# la real (init_point). Pasar a false recién cuando se reemplace el Access
# Token de arriba por uno de producción.
MERCADOPAGO_SANDBOX=true

# URL pública por la que Mercado Pago avisa que un pago cambió de estado
# (webhook, POST /ordenes/webhook) — opcional. Sin esto, los pedidos se
# siguen pudiendo pagar normalmente, pero el backend nunca se entera solo
# de la confirmación (hay que consultarlo a mano contra la API de Mercado
# Pago). localhost NO sirve — Mercado Pago tiene que poder llegar hasta
# acá desde internet. En dev, se resuelve con un túnel:
#   npx ngrok http 3006
# y esta variable queda con la URL https que te da ngrok (sin la barra
# final), ej: MERCADOPAGO_WEBHOOK_URL=https://abcd1234.ngrok-free.app
MERCADOPAGO_WEBHOOK_URL=

# Cantidad de proxies inversos de confianza delante de la app (ej. 1 con nginx).
# Sin esto, req.ip es la IP del proxy y los límites por IP (login, contacto,
# pedidos, webhook) cuentan a todos los visitantes como uno solo. Sin definir,
# no se confía en X-Forwarded-For.
TRUST_PROXY=
